{
  "expo": {
    "name": "WoW Laundry",
    "slug": "Frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/iconic.png",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.salgotra111.customer",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Allow WoW Laundry to access your location to auto-detect your delivery address accurately."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/iconic.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.salgotra111.customer",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-asset",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow WoW Laundry to access your location to auto-detect your delivery address accurately.",
          "locationWhenInUsePermission": "Allow WoW Laundry to access your location to auto-detect your delivery address accurately."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/iconic.png",
          "color": "#002B2E",
          "defaultChannel": "wow_laundry_channel"
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "wow_laundry",
    "extra": {
      "eas": {
        "projectId": "f146fe1a-3e90-4af0-9562-6feb058485b4"
      }
    }
  }
}
