{
  "cli": {
    "version": ">= 20.1.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://wow-backend-isuq.onrender.com/api",
        "ORG_GRADLE_PROJECT_reactNativeArchitectures": "arm64-v8a",
        "ORG_GRADLE_PROJECT_enableProguardInReleaseBuilds": "true"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://wow-backend-isuq.onrender.com/api",
        "ORG_GRADLE_PROJECT_enableProguardInReleaseBuilds": "true"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
